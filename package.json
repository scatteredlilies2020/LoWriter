{
  "name": "lowriter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/launcher.ts",
    "service": "node src/main.ts",
    "open": "node src/launcher.ts",
    "demo": "node src/launcher.ts --demo",
    "cli": "node src/cli.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "diff": "8.0.4",
    "marked": "18.0.13",
    "preact": "10.29.3",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
